{
  "name": "crosspdf-studio",
  "private": true,
  "version": "0.1.0",
  "description": "Professional cross-platform PDF editor",
  "author": "CrossPDF Team",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "perf:baseline": "npx tsx scripts/perf-baseline.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:mac": "pnpm build && electron-builder --mac",
    "package:mac:unsigned": "CSC_IDENTITY_AUTO_DISCOVERY=false pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "package:mac:dev": "CSC_IDENTITY_AUTO_DISCOVERY=false pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --config.extraMetadata.dev=true",
    "package:mac:dir": "CSC_IDENTITY_AUTO_DISCOVERY=false pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --mac",
    "package:mac:zip": "CSC_IDENTITY_AUTO_DISCOVERY=false pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac zip",
    "package:mac:release": "CSC_IDENTITY_AUTO_DISCOVERY=false pnpm build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg zip && bash scripts/prepare-release-artifacts.sh release && bash scripts/verify-update-metadata.sh release",
    "package:mac:signed": "node scripts/check-signing-env.cjs && pnpm build && electron-builder --mac",
    "package:win": "pnpm build && electron-builder --win",
    "package:all": "pnpm build && electron-builder --mac --win",
    "package:dir": "pnpm build && electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "prepare": "husky"
  },
  "dependencies": {
    "@signpdf/placeholder-pdf-lib": "^3.3.0",
    "@signpdf/signer-p12": "^3.3.0",
    "@signpdf/signpdf": "^3.3.0",
    "argparse": "^2.0.1",
    "builder-util-runtime": "^9.7.0",
    "debug": "^4.4.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.3",
    "fs-extra": "^11.3.2",
    "graceful-fs": "^4.2.11",
    "i18next": "^26.3.0",
    "js-yaml": "^4.2.0",
    "jsonfile": "^6.2.1",
    "lazy-val": "^1.0.5",
    "lodash.escaperegexp": "^4.1.2",
    "lodash.isequal": "^4.5.0",
    "lucide-react": "^1.16.0",
    "ms": "^2.1.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "sax": "^1.6.0",
    "semver": "^7.8.4",
    "sql.js": "^1.14.1",
    "tesseract.js": "^6.0.1",
    "tiny-typed-emitter": "^2.1.0",
    "universalify": "^2.0.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.1.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "playwright": "^1.60.0",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^4.1.6"
  }
}
